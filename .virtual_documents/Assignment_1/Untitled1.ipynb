import numpy as np

# 1. تعريف مصفوفة المعاملات ومتجه النواتج
A = np.array([[3.0, 2.0, -1.0],
              [-1.0, 3.0, 2.0],
              [1.0, -1.0, -1.0]])

b = np.array([10.0, 5.0, -1.0])

# 2. التخمين الأولي كما هو مطلوب في السؤال (أصفار)
x_old = np.zeros(3)

# عدد التكرارات المطلوبة
iterations = 10

print("Iteration | x1       | x2       | x3")
print("-" * 45)

# 3. حلقة التكرار (The Loop)
for k in range(iterations):
    # إنشاء متجه فارغ لحفظ القيم الجديدة حتى لا تتداخل مع القديمة
    x_new = np.zeros(3)
    
    # الترجمة الحرفية للمعادلات الثلاث التي كتبناها في الأعلى
    x_new[0] = (b[0] - (A[0, 1] * x_old[1] + A[0, 2] * x_old[2])) / A[0, 0]
    x_new[1] = (b[1] - (A[1, 0] * x_old[0] + A[1, 2] * x_old[2])) / A[1, 1]
    x_new[2] = (b[2] - (A[2, 0] * x_old[0] + A[2, 1] * x_old[1])) / A[2, 2]
    
    # طباعة النتائج لكل تكرار
    print(f"{k+1:9} | {x_new[0]:8.4f} | {x_new[1]:8.4f} | {x_new[2]:8.4f}")
    
    # تحديث القيم: القديمة تصبح هي الجديدة استعداداً للدورة القادمة
    x_old = x_new.copy()

print("-" * 45)
print(f"Final approximate solution after 10 iterations: {x_old}")



